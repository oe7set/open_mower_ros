<?xml version="1.0"?>
<launch>
  <!-- Off-board GNSS detail parser for the v2 firmware. Connects to the
       firmware GPS debug TCP interface, parses NMEA/UBX detail and publishes
       xbot_msgs/GnssDetail on ll/position/gnss_detail (consumed by
       xbot_monitoring -> gnss/stream -> app GNSS page).

       NOTE: the xCore debug port 10000 serves ONE client at a time (the firmware
       accept()-loop is single-client). `openmower expose-gps` performs an
       automatic handoff: it calls /gnss_detail_parser/set_enabled (std_srvs/SetBool)
       to pause this node (releasing the port) for the duration of the u-center
       session, then re-enables it on exit. No manual steps needed. Set
       OM_NO_GNSS_DETAIL=True only to disable this node permanently. -->

  <!-- xCore internal IP on the robot link (same target expose-gps tunnels to). -->
  <arg name="firmware_ip" default="$(optenv OM_GNSS_FIRMWARE_IP 172.16.78.150)"/>
  <arg name="firmware_port" default="10000"/>
  <!-- Receiver protocol (UBX/NMEA). Empty by default: the node then reads the
       single source of truth /ll/services/gps/protocol (loaded from the YAML
       hierarchy by _params.launch), so it always matches what the firmware
       configured. Set OM_GNSS_PROTOCOL or pass protocol:= to force a value. -->
  <arg name="protocol" default="$(optenv OM_GNSS_PROTOCOL)"/>

  <node pkg="gnss_detail_parser" type="gnss_detail_parser_node" name="gnss_detail_parser"
        output="screen" respawn="true" respawn_delay="5"
        unless="$(optenv OM_NO_GNSS_DETAIL False)">
    <param name="firmware_ip" value="$(arg firmware_ip)"/>
    <param name="firmware_port" value="$(arg firmware_port)"/>
    <param name="protocol" value="$(arg protocol)"/>
    <param name="send_config" value="true"/>
    <!-- Auto-resume if a paused state is never refreshed (crashed expose-gps).
         0 disables the watchdog. -->
    <param name="pause_watchdog_timeout" value="300"/>
  </node>
</launch>

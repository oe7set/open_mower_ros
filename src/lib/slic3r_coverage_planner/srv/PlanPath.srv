uint8 FILL_LINEAR=0
uint8 FILL_CONCENTRIC=1
# Archimedean spiral — effectively connected concentric circles, independent of
# the area's polygon shape (unlike FILL_CONCENTRIC which follows the outline).
uint8 FILL_CONCENTRIC_CIRCLE=2
# Space-filling Hilbert curve.
uint8 FILL_HILBERT=3
# Grid (rectilinear in two perpendicular passes) — robust, even coverage.
uint8 FILL_GRID=4
# Honeycomb — robust, even coverage.
uint8 FILL_HONEYCOMB=5
# Octagram spiral — a space-filling curve like FILL_HILBERT/FILL_CONCENTRIC_CIRCLE,
# so it shares their geometry sensitivity and relies on the linear fallback.
uint8 FILL_OCTAGRAM=6
uint8 fill_type
float64 angle
float64 distance
float64 outer_offset
uint8 outline_count
uint8 outline_overlap_count
bool skip_area_outline
bool skip_obstacle_outlines
bool skip_fill
geometry_msgs/Polygon outline
geometry_msgs/Polygon[] holes
---
Path[] paths
# True if at least one area sub-region produced no usable infill for the
# requested fill_type and was filled with FILL_LINEAR as a fallback instead.
bool fill_fallback
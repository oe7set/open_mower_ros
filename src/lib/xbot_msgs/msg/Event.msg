# Lifecycle / notification event emitted by ROS nodes via the
# EventPublisher helper. Mirrored to MQTT (events/stream non-retained,
# events/json retained snapshot) by xbot_monitoring and surfaced in the
# app's notification center.

std_msgs/Header header

uint8 SEVERITY_INFO=0
uint8 SEVERITY_WARNING=1
uint8 SEVERITY_ERROR=2
uint8 SEVERITY_CRITICAL=3

# UUID-v4 string. Generated by the producer; stable across the event lifetime
# so the app can ack/dedupe by id.
string id

# Wall-clock epoch milliseconds at the moment of emission.
uint64 ts_ms

# One of SEVERITY_*.
uint8 severity

# Canonical kebab-case event type, e.g. "mowing.started", "emergency.raised",
# "schedule.run_skipped". Stable identifier — used by filters.
string type

# Originating node name, e.g. "mower_logic", "mower_scheduler",
# "xbot_monitoring".
string source

# One-line user-facing description.
string summary

# Optional structured payload, JSON-stringified. Empty string = no payload.
# xbot_monitoring parses this into a JSON object before forwarding to MQTT.
string details_json
